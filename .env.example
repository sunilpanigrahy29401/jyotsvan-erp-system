# =====================================================================================
# Jyotsvan Enterprise Platform — environment template.  Copy to .env (never commit .env).
# Variables WITHOUT the VITE_ prefix are server-only and are never sent to the browser.
# =====================================================================================

# ---- Required in production (the server refuses to start without them) -----------------
# Signs login sessions. 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=
# Encrypts stored integration credentials. 32+ random characters. Back this up: losing it makes stored credentials unreadable.
ENCRYPTION_SECRET=
# PostgreSQL connection string (server-side only). Use a RESTRICTED role (not a superuser) if you enable RLS.
DATABASE_URL=
NODE_ENV=production

# ---- Database TLS (verified by default) -------------------------------------------------
# DATABASE_SSL=disable                      # local development only
# DATABASE_SSL_CA=                          # PEM of a private CA, if your provider uses one
# DATABASE_SSL_REJECT_UNAUTHORIZED=false    # dev-only escape hatch; refused in production

# ---- Server ------------------------------------------------------------------------------
# PORT=3000
# TRUST_PROXY=1                  # number of reverse proxies in front (so rate limits/IPs are real)
# COOKIE_SECURE=false            # plain-HTTP local development only; keep default (true) in production
# JSON_BODY_LIMIT=5mb
# RLS_ENABLED=true               # only after `npm run db:rls -- --enable` AND the app uses a restricted DB role (see runbook)

# ---- Public browser configuration (safe to expose) ---------------------------------------
# VITE_APP_URL=
# VITE_INSFORGE_PROJECT_ID=
# VITE_INSFORGE_API_URL=
# VITE_INSFORGE_ANON_KEY=

# ---- Inbound webhooks --------------------------------------------------------------------
# Shared key required by POST /api/crm/webhooks/inbound (header x-ingest-key). 16+ characters.
CRM_INGEST_KEY=
# CRM_INGEST_ORG_ID=             # tenant that receives those leads (defaults to the first organization)
# WEBHOOK_ALLOW_UNSIGNED=true    # development only; ignored in production

# ---- AI (optional) -----------------------------------------------------------------------
GEMINI_API_KEY=

# ---- Marketing integrations (optional) ---------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_OAUTH_REDIRECT_URI=

# ---- One-off migration helpers (see docs/engineering/OPERATIONS_RUNBOOK.md) ---------------
# LEGACY_VAULT_KEY_FALLBACK=true # temporarily lets decryption use the old built-in key while re-saving credentials
# LEGACY_TOLERANT_SEEDS=false    # make legacy migrations strict instead of skipping colliding demo seed rows
# RUN_MIGRATIONS_ON_BOOT=false   # development only; migrations never run on boot in production
