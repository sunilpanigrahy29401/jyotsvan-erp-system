# GEMINI_API_KEY: Required for Gemini AI API calls (future AI phase).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# InsForge Platform & Database Configuration
# ==============================================================================
# InsForge Project Identifier
VITE_INSFORGE_PROJECT_ID="your_insforge_project_id"

# InsForge API Gateway / Backend Endpoint (e.g., https://api.insforge.app/v1)
VITE_INSFORGE_API_URL="https://api.insforge.app/v1"

# InsForge Public Anon / Client Key (Safe for browser authentication & client SDK)
VITE_INSFORGE_ANON_KEY="your_insforge_anon_key"

# InsForge PostgreSQL Connection String (Server-side data access)
INSFORGE_DATABASE_URL="postgresql://user:password@db.insforge.app:5432/jyotsvan"

# InsForge Service Role Key (Server-side privileged operations only)
INSFORGE_SERVICE_ROLE_KEY="your_insforge_service_role_key"

# ==============================================================================
# Phase 26: Meta Marketing & Ads API Integration
# ==============================================================================
# Meta Developer App ID (Facebook for Developers)
META_APP_ID="your_meta_app_id"

# Meta Developer App Secret (Server-side ONLY, never exposed to client)
META_APP_SECRET="your_meta_app_secret"

# Meta Graph API Version (e.g., v21.0 or v20.0)
META_API_VERSION="v21.0"

# Meta OAuth Redirect URI for authorization callback
META_OAUTH_REDIRECT_URI="https://your-domain.com/api/integrations/meta/oauth/callback"

